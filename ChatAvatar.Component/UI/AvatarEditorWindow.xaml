<Window x:Class="ChatAvatar.Component.UI.AvatarEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avatar Editor" Width="760" Height="500"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Text="Avatare" />
        <TextBlock Grid.Column="2" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Text="Bearbeiten" />

        <DockPanel Grid.Column="0" Grid.Row="2" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Neu" Padding="12,6" Margin="0,0,8,0" Click="OnNewClicked" />
                <Button Content="Aktualisieren" Padding="12,6" Click="OnRefreshClicked" />
            </StackPanel>
            <ListBox x:Name="AvatarList"
                     ItemsSource="{Binding Avatars}"
                     SelectedItem="{Binding SelectedAvatar, Mode=TwoWay}"
                     DisplayMemberPath="Avatar.DisplayName"
                     SelectionChanged="OnSelectionChanged" />
        </DockPanel>

        <Grid Grid.Column="2" Grid.Row="2" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Text="Name" />
            <TextBox x:Name="NameInput" Grid.Column="1" Grid.Row="0" Padding="7" />
            <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" Text="Darstellung" />
            <ComboBox x:Name="AvatarTypeInput" Grid.Column="1" Grid.Row="2" Padding="6" />
            <TextBlock Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" Text="ID" />
            <TextBlock x:Name="AvatarIdLabel" Grid.Column="1" Grid.Row="4" VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="StatusLabel"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="2" Grid.Row="4" HorizontalAlignment="Right"
                Content="Speichern" Padding="16,7" Click="OnSaveClicked" />
    </Grid>
</Window>