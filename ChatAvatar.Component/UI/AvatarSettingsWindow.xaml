<Window x:Class="ChatAvatar.Component.UI.AvatarSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avatar-Einstellungen" Width="520" Height="460"
        MinWidth="460" MinHeight="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Text="Stimme" />
        <ComboBox x:Name="VoiceInput" Grid.Column="1" Grid.Row="0" Padding="7" />

        <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" Text="Avatar-ID" />
        <TextBox x:Name="AvatarIdInput" Grid.Column="1" Grid.Row="2" Padding="7" />

        <TextBlock Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" Text="Lautstärke" />
        <DockPanel Grid.Column="1" Grid.Row="4">
            <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
            <Slider x:Name="VolumeInput" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnVolumeChanged" />
        </DockPanel>

        <TextBlock Grid.Column="0" Grid.Row="6" VerticalAlignment="Center" Text="Sprechtempo" />
        <DockPanel Grid.Column="1" Grid.Row="6">
            <TextBlock x:Name="RateValue" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
            <Slider x:Name="RateInput" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnRateChanged" />
        </DockPanel>

        <TextBlock x:Name="ValidationLabel" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="10"
                   Foreground="#B42318" TextWrapping="Wrap" />
        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="12"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Padding="14,7" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Übernehmen" Padding="14,7" IsDefault="True" Click="OnApplyClicked" />
        </StackPanel>
    </Grid>
</Window>