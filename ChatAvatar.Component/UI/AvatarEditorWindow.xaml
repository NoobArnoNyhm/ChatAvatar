<Window x:Class="ChatAvatar.Component.UI.AvatarEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avatar="clr-namespace:ChatAvatar.Component.UI"
    Title="Avatar Editor" Width="980" Height="700"
    MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Text="Avatare" />
        <TextBlock Grid.Column="2" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Text="Bearbeiten" />

        <DockPanel Grid.Column="0" Grid.Row="2" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Neu" Padding="12,6" Margin="0,0,8,0" Click="OnNewClicked" />
                <Button Content="Aktualisieren" Padding="12,6" Click="OnRefreshClicked" />
            </StackPanel>
            <ListBox x:Name="AvatarList"
                     ItemsSource="{Binding Avatars}"
                     SelectedItem="{Binding SelectedAvatar, Mode=TwoWay}"
                     DisplayMemberPath="Avatar.DisplayName"
                     SelectionChanged="OnSelectionChanged" />
        </DockPanel>

        <Grid Grid.Column="2" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Text="Name" />
                    <TextBox x:Name="NameInput" Grid.Column="1" Grid.Row="0" Padding="7" TextChanged="OnAppearanceChanged" />
                    <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" Text="Darstellung" />
                    <ComboBox x:Name="AvatarTypeInput" Grid.Column="1" Grid.Row="2" Padding="6" SelectionChanged="OnAvatarTypeChanged" />
                    <TextBlock Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" Text="ID" />
                    <TextBlock x:Name="AvatarIdLabel" Grid.Column="1" Grid.Row="4" VerticalAlignment="Center" />
                </Grid>

                <StackPanel x:Name="FaceSettingsPanel" Margin="0,14,0,0">
                    <TextBlock Margin="0,0,0,4" Text="Face model asset" />
                    <TextBox x:Name="FaceModelPathInput" Padding="7" TextChanged="OnAppearanceChanged" />
                    <TextBlock Margin="0,10,0,4" Text="Mundskalierung" />
                    <DockPanel>
                        <TextBlock x:Name="MouthScaleValue" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Slider x:Name="MouthScaleInput" Minimum="0.5" Maximum="2" Value="1" ValueChanged="OnAppearanceChanged" />
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="ImageSettingsPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Margin="0,0,0,4" Text="Texture asset path" />
                    <TextBox x:Name="TexturePathInput" Padding="7" TextChanged="OnAppearanceChanged" />
                    <TextBlock Margin="0,10,0,4" Text="Farbton (#RRGGBB)" />
                    <TextBox x:Name="TintColorInput" Padding="7" TextChanged="OnAppearanceChanged" />
                </StackPanel>

                <StackPanel x:Name="AbstractSettingsPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Margin="0,0,0,4" Text="Lichtfarbe (#RRGGBB)" />
                    <TextBox x:Name="LightColorInput" Padding="7" TextChanged="OnAppearanceChanged" />
                    <TextBlock Margin="0,10,0,4" Text="Pulsintensität" />
                    <DockPanel>
                        <TextBlock x:Name="PulseIntensityValue" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Slider x:Name="PulseIntensityInput" Minimum="0" Maximum="1" Value="0.65" ValueChanged="OnAppearanceChanged" />
                    </DockPanel>
                </StackPanel>
                <TextBlock x:Name="ValidationLabel" Margin="0,12,0,0" Foreground="#B42318" TextWrapping="Wrap" />
            </StackPanel>

            <avatar:AvatarWebView x:Name="Preview" Grid.Row="2" MinHeight="180" />
        </Grid>

        <TextBlock x:Name="StatusLabel"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4"
                   VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="2" Grid.Row="4" HorizontalAlignment="Right"
                Content="Speichern" Padding="16,7" Click="OnSaveClicked" />
    </Grid>
</Window>